# Supabase project credentials (safe to expose client-side — RLS
# policies enforce access control, not this key)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"

# Server-side only — used by the invite-staff Edge Function.
# NEVER prefix this with VITE_ (would ship it to the browser).
# Set this via `supabase secrets set`, not in this file.
# SUPABASE_SERVICE_ROLE_KEY="..."
